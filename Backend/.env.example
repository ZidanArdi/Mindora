APP_PORT=8080
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BCRYPT_COST=12

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=mindora_user
DB_PASSWORD=your_secure_password
DB_NAME=mindora
DB_SSLMODE=disable
DATABASE_URL=postgres://mindora_user:your_secure_password@localhost:5433/mindora?sslmode=disable

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_ENABLED=false

# Cloudflare Turnstile Bot Protection
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=0x4AAAAAA...your_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_EXPECTED_ACTION=

# Cookie Settings
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Reverse Proxy Trust Settings
ENABLE_TRUSTED_PROXY_CHECK=true
TRUSTED_PROXIES=127.0.0.1,::1

# Groq Cloud LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=30s
